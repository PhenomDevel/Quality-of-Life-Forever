<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Gray explanatory line below a settings row, see Core/Settings.lua. -->
	<Frame name="QualityOfLifeForeverSettingsNoteTemplate" mixin="QualityOfLifeForeverSettingsNoteMixin" virtual="true">
		<Size y="16"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false"/>
			</Layer>
		</Layers>
	</Frame>
	<!-- Section title inside a module's options ("header" option type). -->
	<Frame name="QualityOfLifeForeverSettingsSubheaderTemplate" mixin="QualityOfLifeForeverSettingsNoteMixin" virtual="true">
		<Size y="22"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="BOTTOM" wordwrap="false"/>
			</Layer>
		</Layers>
	</Frame>
	<!-- Thin line between two modules on a category page. -->
	<Frame name="QualityOfLifeForeverSettingsDividerTemplate" mixin="QualityOfLifeForeverSettingsDividerMixin" virtual="true">
		<Size y="13"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Line">
					<Size y="1"/>
					<Anchors>
						<Anchor point="LEFT" x="37"/>
						<Anchor point="RIGHT" x="-20"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0.12"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
</Ui>
