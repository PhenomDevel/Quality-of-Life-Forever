# BigWigs packager config, see .github/workflows/release.yml.
package-as: QualityOfLifeForever

# The addon lives in a subfolder; move it to the zip root.
move-folders:
  QualityOfLifeForever/QualityOfLifeForever: QualityOfLifeForever

ignore:
  - README.md
  - CLAUDE.md
  - docs
  - tools

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
